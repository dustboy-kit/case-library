{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dustboy-kit/case-library/case.schema.json",
  "title": "case.json: one 3D-printable case in the library",
  "type": "object",
  "required": ["id", "name", "version", "status", "license", "authors", "summary", "entry", "openscad", "print_parts", "hardware", "printed"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$", "description": "Same as the folder name under cases/ (or the repo name for a registry entry)." },
    "name": { "type": "string", "minLength": 3 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "description": "Semver. Bump it in the same PR that changes the geometry." },
    "status": {
      "enum": ["concept", "cad-fit-checked", "printed", "field-tested"],
      "description": "concept: drawn, sizes not checked. cad-fit-checked: a fit check against part models passes. printed: someone printed it and the parts went in (fit report issue). field-tested: used for real, e.g. in a classroom."
    },
    "license": { "type": "string", "description": "SPDX id, e.g. MIT, CC-BY-4.0, CC-BY-SA-4.0." },
    "authors": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "summary": { "type": "string", "minLength": 10 },
    "kit": { "type": "string" },
    "entry": { "type": "string", "pattern": "\\.scad$", "description": "The OpenSCAD file that builds every part." },
    "openscad": {
      "type": "object",
      "required": ["min_version"],
      "properties": {
        "min_version": { "type": "string" },
        "backend": { "enum": ["manifold", "cgal"] },
        "libraries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "url"],
            "properties": { "name": { "type": "string" }, "url": { "type": "string" }, "commit": { "type": "string" } }
          }
        }
      }
    },
    "print_parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene", "stl"],
        "properties": {
          "scene": { "type": "string", "description": "Value of the `scene` variable that exports this part: openscad -D 'scene=\"<scene>\"'." },
          "stl": { "type": "string" }
        }
      }
    },
    "variants": {
      "type": "array",
      "description": "Optional. Printable variants built from the same entry file, e.g. one body x grille each. The gallery shows each as its own card.",
      "items": {
        "type": "object",
        "required": ["id", "name", "stl"],
        "properties": {
          "id": { "type": "string" }, "name": { "type": "string" }, "preview": { "type": "string" },
          "stl": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "preview": { "type": "string" },
    "outer_mm": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "hardware": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["part", "size_source"],
        "properties": {
          "part": { "type": "string" },
          "size_mm": { "type": "array", "items": { "type": "number" } },
          "size_source": { "enum": ["datasheet", "measured", "typical", "photo-estimate"], "description": "Where the part size came from. Be honest: photo-estimate cases stay at status concept." },
          "note": { "type": "string" }
        }
      }
    },
    "checks": { "type": "object" },
    "printed": { "type": "boolean" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "origin": { "type": "string" }
  }
}
